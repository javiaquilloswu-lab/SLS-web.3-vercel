<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Dot Indicator -->
        <View
            android:id="@+id/dotIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_pill_rejected"
            android:backgroundTint="@color/secondary_ruby" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grade Slip (2nd Sem)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📅 Due Aug 20, 2026 • Bursar Review"
                android:textColor="@color/secondary_ruby"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnActionNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_processing"
            android:backgroundTint="#F1F5F9">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
