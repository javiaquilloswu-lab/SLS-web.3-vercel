{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "^/api/health$",
      "dest": "/api/index.php?endpoint=health"
    },
    {
      "src": "^/api/([a-zA-Z0-9_]+)(?:\\.php)?$",
      "dest": "/api/index.php?endpoint=$1"
    }
  ]
}
