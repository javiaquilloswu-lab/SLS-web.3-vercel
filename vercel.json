{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.php?endpoint=health"
    },
    {
      "source": "/api/:endpoint",
      "destination": "/api/index.php?endpoint=:endpoint"
    }
  ]
}